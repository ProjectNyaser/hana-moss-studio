{
  "manifestVersion": 2,
  "id": "hana-moss-studio",
  "name": "苔室",
  "version": "0.1.0",
  "description": "MOSS-Image 的本机出图工作台：自带 CUDA 引擎进程、串行队列、提示词面板与画廊；工具出图在对话里挂实时进度卡，左侧状态面板跟着当前任务走。",
  "entry": "index.js",
  "icon": "assets/icon.png",
  "minAppVersion": "1.5.7-beta",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/process.spawn",
    "app/tasks.manage",
    "app/session.start-turn"
  ],
  "contributes": {
    "cards": [
      {
        "id": "studio",
        "title": "苔室",
        "description": "MOSS-Image 出图工作台：提示词、参数、队列与画廊",
        "route": "/studio.html",
        "realization": "page",
        "siteNavEntry": true,
        "fpFullPanel": true,
        "cardForm": "flush",
        "titlebar": "solid",
        "functionPanel": {
          "id": "status",
          "label": "苔室状态",
          "route": "/panel.html"
        },
        "face": {
          "image": "assets/cover.png"
        },
        "pageIcon": "assets/page-icon.svg"
      }
    ]
  }
}
