{
  "manifestVersion": 2,
  "id": "moss-studio",
  "name": "苔室",
  "version": "0.1.0",
  "description": "MOSS-Image 的本机出图工作台：自带 CUDA 引擎进程、串行队列、提示词面板与画廊",
  "entry": "index.js",
  "icon": "assets/icon.svg",
  "minAppVersion": "1.5.7-beta",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/process.spawn"
  ],
  "contributes": {
    "cards": [
      {
        "id": "studio",
        "title": "苔室",
        "description": "MOSS-Image 出图工作台：提示词、参数、队列与画廊",
        "route": "/studio.html",
        "realization": "page",
        "siteNavEntry": true,
        "fpFullPanel": true,
        "cardForm": "flush",
        "titlebar": "solid",
        "face": {
          "image": "assets/cover.svg"
        }
      }
    ]
  }
}
